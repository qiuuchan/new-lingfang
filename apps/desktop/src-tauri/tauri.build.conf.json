{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "千匣台",
  "version": "0.1.11",
  "identifier": "com.qianxia.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node ../../scripts/materialize-bundled-runtimes.mjs && node node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "node ../../scripts/materialize-bundled-runtimes.mjs && node node_modules/vite/bin/vite.js build"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../builtin-plugins": "builtin-plugins",
      "../runtimes": "runtimes"
    },
    "copyright": "© 2026 千匣台",
    "shortDescription": "千匣台 协作平台桌面客户端",
    "longDescription": "千匣台 协作平台桌面客户端：AI 插件创建、团队协作、插件市场与钱包，内置完整插件运行环境。",
    "publisher": "千匣台",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "千匣台",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "center": true,
        "windowEffects": {
          "effects": ["mica"],
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*:* http://localhost:* ws://localhost:*; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self'; child-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  }
}
