{
  "name": "@lingfang/desktop",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "vite": "vite",
    "vite:build": "vite build",
    "runtime:prepare": "node ../../scripts/materialize-bundled-runtimes.mjs",
    "runtime:populate": "node ../../scripts/populate-local-runtimes.mjs",
    "runtime:verify": "pnpm runtime:prepare && node ../../scripts/verify-bundled-runtimes.mjs",
    "build:frontend": "pnpm runtime:verify && pnpm vite:build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node ../../scripts/e2e-desktop-smoke.mjs",
    "test:install": "node ../../scripts/e2e-install-verify.mjs",
    "test:relay": "node ../../scripts/e2e-relay-verify.mjs",
    "test:actions": "node ../../scripts/e2e-actions-verify.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@lingfang/contract": "workspace:*",
    "@lingfang/ui-tokens": "workspace:^",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.8"
  }
}
