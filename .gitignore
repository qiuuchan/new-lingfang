# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
target/
release/
*.tsbuildinfo

# 运行时（随包分发，不入仓）。目录本身必须入库：tauri.conf.json 把 ../runtimes
# 声明为打包资源，tauri-build 编译期要求其存在——没有 .gitkeep 时全新 clone /
# CI 直接 "resource path `..\runtimes` doesn't exist" 编译失败。
apps/desktop/runtimes/*
!apps/desktop/runtimes/.gitkeep
apps/desktop/src-tauri/runtimes/

# 本地环境
.env
.env.*
!.env.example
!.env.collab.example

# 日志与缓存
*.log
.vite/
eslintcache

# 打包产物
*.lfplugin
*.exe
*.msi

# Trellis 内部工作痕迹（新仓库不使用）
.trellis/

# B3: 本地生成的运行时 minisign 密钥（绝不入库；仅本机/CI 通过 Org secret 持有）
.runtime-signing/
# AI 工具本地目录（.codebuddy: workflows/plans；.zcode）——不进仓库
.codebuddy/
.zcode/
